{
  "name": "choyxona-backend",
  "version": "1.0.0",
  "description": "Azamatjon & Umidjon Restarani - Omborxona va Tannarx Tizimi",
  "main": "dist/server.js",
"scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "build": "node node_modules/typescript/bin/tsc",
    "migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.x.x",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prisma": "^5.x.x", 
    "socket.io": "^4.7.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
